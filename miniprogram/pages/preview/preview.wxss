.wrap {
  min-height: 100vh;
  background: #0b0f16;
}

.swiper {
  width: 100vw;
  height: 78vh;
}

.full {
  width: 100%;
  height: 100%;
}

.counter {
  position: fixed;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 24rpx;
}

.ad-wrap {
  padding: 0 20rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(11, 15, 22, 0.92);
}

.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

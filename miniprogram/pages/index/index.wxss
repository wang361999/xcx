.page {
  padding: 24rpx 24rpx 60rpx;
}

.header {
  padding: 12rpx 8rpx 24rpx;
}

.h-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.h-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.ad-wrap {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.promo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  margin-bottom: 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #111827 0%, #374151 100%);
  color: #fff;
}

.promo-txt {
  font-size: 30rpx;
  font-weight: 600;
}

.promo-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
}

.promo-btn {
  flex: none;
  margin-left: 20rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f59e0b;
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}

.promo-btn.done {
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-weight: 500;
}

.grid {
  display: grid;
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.06);
}

.cover-box {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
  background: #e5e7eb;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
}

.badge.unlocked {
  background: rgba(16, 185, 129, 0.92);
}

.meta {
  padding: 16rpx 18rpx 20rpx;
}

.title {
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.count {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.footer {
  padding: 48rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
}

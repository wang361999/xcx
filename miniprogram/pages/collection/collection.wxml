<view class="page">
  <view class="top">
    <view class="title">{{detail.title}}</view>
    <view class="desc muted" wx:if="{{detail.description}}">{{detail.description}}</view>
    <view class="stat muted">{{detail.images.length}} 张图片</view>
  </view>

  <view class="grid">
    <view class="cell" wx:for="{{detail.images}}" wx:key="id" bindtap="onPreview" data-index="{{index}}">
      <image class="img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
      <view class="lock" wx:if="{{!unlocked}}">
        <text class="lock-icon">🔒</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && detail.images.length === 0}}">该合集暂无图片</view>

  <view class="ad-wrap" wx:if="{{banners.bottom}}">
    <ad unit-id="{{banners.bottom}}" ad-intervals="60"></ad>
  </view>

  <view class="bar" wx:if="{{!unlocked}}">
    <button class="btn primary" bindtap="onUnlock">
      {{freeLeft > 0 ? '免费解锁（今日剩 ' + freeLeft + ' 次）' : '看广告解锁下载'}}
    </button>
  </view>

  <view class="bar netdisk" wx:else>
    <block wx:if="{{downloadUrl}}">
      <view class="nd-title">原图包下载（百度网盘）</view>
      <view class="nd-tip muted">复制链接后打开百度网盘 App，再粘贴提取码</view>
      <view class="nd-row">
        <button class="btn primary" bindtap="onCopyLink">复制下载链接</button>
        <button class="btn ghost" wx:if="{{downloadCode}}" bindtap="onCopyCode">提取码 {{downloadCode}}</button>
      </view>
    </block>
    <block wx:else>
      <view class="nd-tip muted">该合集暂未配置网盘链接，可先保存预览图</view>
    </block>
  </view>
</view>
